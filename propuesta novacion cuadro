function initGastoNov() {
    var GID_GASTO = '7f0df958-9e6d-48ba-95e3-0b3a8bc2e0fe';
    var intentos = 0;
    function intentar() {
        var dd = kendo.jQuery('#' + GID_GASTO).data('kendoDropDownList');
        var tipo = (sessionStorage.TipoCobro || '').toUpperCase();
        if (!dd || (tipo === '' && intentos < 15)) { intentos++; setTimeout(intentar, 300); return; }
        var objetivo = (tipo.indexOf('HONORARIO') === 0) ? 'HONORARIOS' : 'GASTOS';
        var textField  = dd.options.dataTextField;
        var valueField = dd.options.dataValueField;
        var data = dd.dataSource.data();
        for (var i = 0; i < data.length; i++) {
            var t = (data[i][textField] || '').toString().toUpperCase();
            if (t.indexOf(objetivo) === 0) {
                dd.value(data[i][valueField]);
                dd.trigger('change');
                break;
            }
        }
    }
    intentar();
}

